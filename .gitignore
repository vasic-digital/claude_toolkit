
# Python bytecode
__pycache__/
*.pyc
scratch_*.log

# Node dependencies for the TOON utility — installed via `npm install`
# (run automatically by install.sh). Never vendor these into git.
/node_modules/

# Local build/probe cache — the compiled LLMsVerifier binaries + probe artifacts
# cached by claude-verify-providers.sh (LV_BIN default $REPO_ROOT/.local-cache/…).
# Regenerable from source (§11.4.53 — never version build artifacts).
/.local-cache/

# Agent scratch/progress ledger — never commit
.superpowers/
scripts/proxy/bin/
logs/
verification_results/

# Live multi-prompt TUI evidence — regenerable ad-hoc, do not commit
scripts/tests/proof/verify-aliases-multi-prompt/

# Volatile proof output (D1, B-proof-writers): every regenerated run artifact
# (timestamps, ports, PIDs, sandbox paths) is written here and never tracked.
# Only the curated scripts/tests/proof/{.gitkeep,PROOF.md,00-summary.txt} stay tracked.
scripts/tests/proof/volatile/

# Flat own-org checkouts a developer may place in-tree (resolve_deps.sh tier 3).
# They are NOT submodules of this repo (operator decision 2026-10-21) and must
# never be committed here; the parent hub or a sibling clone is preferred.
/submodules/llms_verifier/
/submodules/LLMsVerifier/
/submodules/claude_code_router/
/submodules/claude-code-router/
